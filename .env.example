# Copy to .env and fill in. scripts/gcp_cluster.sh sources this file.
# If GCP_PROJECT_ID is empty, the script falls back to `gcloud config get-value project`.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
# Holds data/raw/, processed/, submissions/<RUN_ID>/ and sessions/.
GCS_BUCKET_URI=gs://sasol-train-dataset
GCE_INSTANCE_NAME=sasol-gpu-trainer
GCE_MACHINE_TYPE=g2-standard-8
GCE_ACCELERATOR=type=nvidia-l4,count=1

# Fallback used automatically when L4 capacity/quota is unavailable.
GCE_FALLBACK_MACHINE_TYPE=n1-standard-8
GCE_FALLBACK_ACCELERATOR=type=nvidia-tesla-t4,count=1
# Extra zones tried (in order) if the primary zone has no capacity.
GCE_FALLBACK_ZONES="us-central1-b us-central1-c us-central1-f"


# gpu = L4 -> T4 Deep Learning VM (needs GPU quota). cpu = high-core CPU VM, no GPU quota.
GCE_MODE=gpu
GCE_CPU_MACHINE_TYPE=c2d-highcpu-32
GCE_CPU_FALLBACK_MACHINE_TYPE=n2-highcpu-32
# 1 = Spot VM in CPU mode (much cheaper; may be preempted -> rerun `make gcp-run-cpu`).
GCE_SPOT=1
