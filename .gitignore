# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.log
.pytest_cache/
.venv/

# Secrets / local cloud config
.env
.gcp_state

# Data: raw transactions and all derived artefacts stay out of git.
# The small authoritative competition files are whitelisted below.
data/raw/*
!data/raw/label_rules.py
!data/raw/label_config.json
!data/raw/DATA_DICTIONARY.md
!data/raw/LABEL_RULES.md
!data/raw/test.csv
!data/raw/SampleSubmission.csv
data/processed/*
!data/processed/.gitkeep

# Model artefacts
models/*.pkl
models/*.cbm
models/*.json
models/*.txt
catboost_info/

# Bundles / archives
*.zip

# OS / Editor files
.vscode/
.idea/
.DS_Store
Thumbs.db
.adk/

# Local run outputs (backed up via make sessions-push)
logs/
submissions/*
!submissions/.gitkeep
